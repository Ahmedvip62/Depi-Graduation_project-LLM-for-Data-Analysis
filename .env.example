# Environment configuration template for the Universal Analyst backend.
# Copy to `.env` and adjust. The backend reads these via pydantic-settings.

# --- Server ---
HOST=0.0.0.0
PORT=8000
# `development` or `production`. Read as ENVIRONMENT (alias: ENV).
ENVIRONMENT=development

# --- Ollama (LLM runtime) ---
# Bare-host / notebook (Ollama on the same machine):
OLLAMA_HOST=http://localhost:11434
# Docker (Ollama on the host, backend in a container) - use instead:
# OLLAMA_HOST=http://host.docker.internal:11434

# --- Models ---
# Primary answering model.
MODEL_NAME=gemma4:12b
# Small, fast model used for intent routing / classification.
ROUTER_MODEL_NAME=gemma4:e4b
# Embedding model for the RAG layer (downloaded automatically by
# sentence-transformers on first use).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- RAG ---
# Token budget for the assembled RAG context window.
MAX_CONTEXT_TOKENS=6000

# --- Vector store (ChromaDB) ---
# Local persistence directory. Use /chroma_data (dev compose) or
# /app/chroma_data (prod compose) inside containers.
CHROMA_PERSIST_DIRECTORY=./chroma_data

# --- CORS ---
# Comma-separated allowed origins. Read as ALLOWED_ORIGINS (alias: CORS_ORIGINS).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# --- Multimodal chat ---
# Gemma 4 12B in Ollama is used for text + image turns.
IMAGE_CHAT_ENABLED=true
MAX_CHAT_IMAGES=3
MAX_CHAT_IMAGE_MB=5
# Visible frontend token meter window. The RAG prompt still uses MAX_CONTEXT_TOKENS above.
CONTEXT_WINDOW_TOKENS=256000